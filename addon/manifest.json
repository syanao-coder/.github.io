{
  "manifest_version": 3,
  "name": "Sync Player Controller",
  "version": "2.11.0",
  "description": "ローカルのコントローラーから動画操作を同期制御し、YouTube一覧の追加中継と、アーカイブチャットの取得（InnerTube直接取得）を行います。",
  "permissions": [
    "tabs",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage",
    "tabHide"
  ],
  "host_permissions": [
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://syanao-coder.github.io/*",
    "*://animestore.docomo.ne.jp/*",
    "*://*.amazon.co.jp/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://syanao-coder.github.io/*"
      ],
      "js": ["content_controller.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://animestore.docomo.ne.jp/*",
        "*://*.amazon.co.jp/*"
      ],
      "js": ["content_video.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": ["content_youtube_scrape.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": ["content_yt_embed.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sync-player-controller-firefox@syanao-coder.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
